# ==============================================================================
# Apigee AI Gateway — Live Integration Test Environment Template
# Copy to tests/env/<your-env>.env (gitignored) and populate real values:
#   cp tests/env/example.env tests/env/dev.env
#   ./tests/run.sh byo --env tests/env/dev.env
# ==============================================================================

export PROJECT_ID="your-gcp-project-id"
export APIGEE_ENV="eval"
export APIGEE_HOST="api.example.com"
export SERVICE_ACCOUNT="ai-gateway-runtime@your-gcp-project-id.iam.gserviceaccount.com"
export PROXY_NAME="ai-gateway"

# Persona Consumer Keys (provisioned via ./scripts/sync-personas.sh)
export API_KEY="YOUR_KNOWLEDGE_WORKER_CONSUMER_KEY"
export DEV_KEY="YOUR_DEVELOPER_CONSUMER_KEY"
export IT_KEY="YOUR_IT_CONSUMER_KEY"
export AGENT_KEY="YOUR_AGENT_CONSUMER_KEY"
export RESTRICTED_KEY="YOUR_RESTRICTED_CONSUMER_KEY"

# Strict Model Armor template used by live DLP/PII tests
export STRICT_ARMOR_TEMPLATE="ai-gw-strict-template"
