<?xml version="1.0" encoding="UTF-8"?>
<TargetEndpoint name="openai-custom">
  <Description>Target Endpoint for Direct OpenAI and External OpenAI-Compatible Endpoints</Description>
  <FaultRules>
    <FaultRule name="sanitize">
      <Condition>(SanitizeModelResponse.SMR-SanitizeModelResponse.filterMatchState = "MATCH_FOUND") or (SanitizeModelResponse.SMR-SanitizeModelResponse.sdpFilterResult.deidentifyResult.matchState = "MATCH_FOUND")</Condition>
      <Step>
        <Name>JS-inject-deidentified-finding</Name>
      </Step>
      <Step>
        <Name>AM-CustomError</Name>
      </Step>
    </FaultRule>
  </FaultRules>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>AM-DisablePathSuffixCopy</Name>
      </Step>
      <Step>
        <Name>JS-restore-model-openai</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <EventFlow name="EventFlow" content-type="text/event-stream">
    <Response>
      <Step>
        <Name>JS-combine-resp</Name>
      </Step>
      <Step>
        <Name>JS-calculate-monetization-cost</Name>
        <Condition>usage_total_tokens != null</Condition>
      </Step>
      <Step>
        <Name>DC-CaptureTokenCountsStreaming</Name>
        <Condition>usage_total_tokens != null</Condition>
      </Step>
      <Step>
        <Name>LTQ-CountOnly</Name>
        <Condition>usage_total_tokens != null and apiproduct.name != null</Condition>
      </Step>
      <Step>
        <Name>SMR-SanitizeModelResponse</Name>
        <Condition>(model_armor_response_enabled != "false") and (buff_ready = "true") and (response_partial != null) and (response_partial != "")</Condition>
      </Step>
    </Response>
  </EventFlow>
  <Flows/>
  <PostFlow name="PostFlow">
    <Request/>
    <Response>
      <Step>
        <Name>JS-gemini-to-anthropic-resp</Name>
        <Condition>!(stream = true) and (response.status.code &lt; 400) and (request_format != "openai")</Condition>
      </Step>
    </Response>
  </PostFlow>
  <HTTPTargetConnection>
    <URL>https://api.openai.com/v1/chat/completions</URL>
    <SSLInfo>
      <Enabled>true</Enabled>
      <Enforce>true</Enforce>
    </SSLInfo>
    <Properties>
      <Property name="connect.timeout.millis">5000</Property>
      <Property name="io.timeout.millis">300000</Property>
      <Property name="keepalive.timeout.millis">50000</Property>
      <Property name="success.codes">1xx,2xx,3xx,4xx,5xx</Property>
    </Properties>
  </HTTPTargetConnection>
</TargetEndpoint>
