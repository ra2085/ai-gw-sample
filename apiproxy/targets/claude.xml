<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="claude">
  <Description/>
  <FaultRules>
    <FaultRule name="sanitize">
      <Step>
        <Name>JS-inject-deidentified-finding</Name>
      </Step>
      <Step>
        <Name>AM-CustomError</Name>
      </Step>
      <Condition>(SanitizeUserPrompt.SUP-SanitizeUserPrompt.filterMatchState  = "MATCH_FOUND") or (SanitizeModelResponse.SMR-SanitizeModelResponse.sdpFilterResult.deidentifyResult.matchState = "MATCH_FOUND") or (SanitizeUserPrompt.SUP-SanitizeUserPrompt.sdpFilterResult.deidentifyResult.matchState = "MATCH_FOUND")</Condition>
    </FaultRule>
  </FaultRules>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>AM-DisablePathSuffixCopy</Name>
      </Step>
      <Step>
        <Name>JS-inject-anthropic-version</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <Flows/>
  <EventFlow name="EventFlow" content-type="text/event-stream">
    <Response>
      <Step>
        <Name>JS-combine-resp</Name>
      </Step>
      <Step>
        <Condition>usage_total_tokens != null</Condition>
        <Name>DC-CaptureTokenCountsStreaming</Name>
      </Step>
      <Step>
        <Condition>usage_total_tokens != null and apiproduct.name != null</Condition>
        <Name>LTQ-CountOnly</Name>
      </Step>
      <Step>
        <Condition>buff_ready = "true"</Condition>
        <Name>SMR-SanitizeModelResponse</Name>
      </Step>
    </Response>
  </EventFlow>
  <HTTPTargetConnection>
    <Properties>
      <Property name="io.timeout.millis">300000</Property>
    </Properties>
    <Authentication>
      <GoogleAccessToken>
        <Scopes>
          <Scope>https://www.googleapis.com/auth/cloud-platform</Scope>
        </Scopes>
      </GoogleAccessToken>
    </Authentication>
    <URL>https://{endpoint_host}/v1/projects/{propertyset.config.project_id}/locations/{model_location}/publishers/anthropic/models/{model}:streamRawPredict</URL>
    <!--<URL>https://api.anthropic.com</URL>-->
  </HTTPTargetConnection>
</TargetEndpoint>
