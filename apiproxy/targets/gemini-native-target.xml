<?xml version="1.0" encoding="UTF-8"?>
<TargetEndpoint name="gemini-native-target">
  <Description>Target Endpoint for native Gemini requests</Description>
  <FaultRules>
    <FaultRule name="sanitize">
      <Condition>(SanitizeUserPrompt.SUP-SanitizeUserPrompt.filterMatchState = "MATCH_FOUND") or (SanitizeModelResponse.SMR-SanitizeModelResponse.filterMatchState = "MATCH_FOUND") or (SanitizeModelResponse.SMR-SanitizeModelResponse.sdpFilterResult.deidentifyResult.matchState = "MATCH_FOUND") or (SanitizeUserPrompt.SUP-SanitizeUserPrompt.sdpFilterResult.deidentifyResult.matchState = "MATCH_FOUND") or (SanitizeUserPrompt.SUP-SanitizeUserPromptGemini.filterMatchState = "MATCH_FOUND") or (SanitizeUserPrompt.SUP-SanitizeUserPromptGemini.sdpFilterResult.deidentifyResult.matchState = "MATCH_FOUND")</Condition>
      <Step>
        <Name>JS-inject-deidentified-finding</Name>
      </Step>
      <Step>
        <Name>AM-CustomError</Name>
      </Step>
    </FaultRule>
  </FaultRules>
  <PreFlow name="PreFlow">
    <Request/>
    <Response/>
  </PreFlow>
  <EventFlow name="EventFlow" content-type="text/event-stream">
    <Response>
      <Step>
        <Name>JS-combine-resp</Name>
      </Step>
      <Step>
        <Name>JS-calculate-monetization-cost</Name>
        <Condition>usage_total_tokens != null</Condition>
      </Step>
      <Step>
        <Name>DC-CaptureTokenCountsStreaming</Name>
        <Condition>usage_total_tokens != null</Condition>
      </Step>
      <Step>
        <Name>LTQ-CountOnly</Name>
        <Condition>usage_total_tokens != null and apiproduct.name != null</Condition>
      </Step>
      <Step>
        <Name>SMR-SanitizeModelResponse</Name>
        <Condition>(model_armor_response_enabled != "false") and (buff_ready = "true") and (response_partial != null) and (response_partial != "")</Condition>
      </Step>
    </Response>
  </EventFlow>
  <Flows/>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <HTTPTargetConnection>
    <URL>https://aiplatform.googleapis.com</URL>
    <Authentication>
      <GoogleAccessToken>
        <Scopes>
          <Scope>https://www.googleapis.com/auth/cloud-platform</Scope>
        </Scopes>
      </GoogleAccessToken>
    </Authentication>
    <Properties>
      <Property name="io.timeout.millis">300000</Property>
      <Property name="success.codes">1xx,2xx,3xx,429,5xx</Property>
    </Properties>
  </HTTPTargetConnection>
</TargetEndpoint>
