<?xml version="1.0" encoding="UTF-8"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-SetQuotaHeaders">
  <DisplayName>AM-SetQuotaHeaders</DisplayName>
  <Set>
    <Headers>
      <Header name="x-quota-mode">{primary_quota_mode}</Header>
      <Header name="x-quota-allowed">{ratelimit.LTQ-EnforceOnly.allowed.count}</Header>
      <Header name="x-quota-used">{ratelimit.LTQ-CountOnly.used.count}</Header>
      <Header name="x-quota-available">{ratelimit.LTQ-CountOnly.available.count}</Header>
      <Header name="x-quota-ip-used">{ratelimit.LTQ-CountOnly-IP.used.count}</Header>
      <Header name="x-quota-ip-available">{ratelimit.LTQ-CountOnly-IP.available.count}</Header>
      <Header name="x-ratelimit-burst-rate">{burst_rate_limit}</Header>
      <Header name="x-ratelimit-concurrency-limit">{ratelimit.Q-ConcurrencyLimit.allowed.count}</Header>
      <Header name="x-ratelimit-concurrency-active">{ratelimit.Q-ConcurrencyLimit.used.count}</Header>
      <Header name="x-ratelimit-concurrency-available">{ratelimit.Q-ConcurrencyLimit.available.count}</Header>
      <Header name="X-Gateway-Requested-Model">{requested_model}</Header>
      <Header name="X-Gateway-Routed-Model">{primary_model}</Header>
      <Header name="X-Gateway-Cost-Tier">{cost_tier}</Header>
      <Header name="X-Gateway-Fallback-Model">{fallback_model}</Header>
      <Header name="X-Gateway-Fallback-Triggered">{fallback_triggered}</Header>
      <Header name="X-Gateway-Circuit-Breaker">{circuit_breaker_state}</Header>
      <Header name="X-Gateway-Judge-Task">{judge_task}</Header>
      <Header name="X-Gateway-Judge-Complexity">{judge_complexity}</Header>
      <Header name="X-Gateway-Judge-Tier">{judge_tier}</Header>
      <Header name="X-Gateway-Model-Armor-Request-Template">{model_armor_request_template}</Header>
      <Header name="X-Gateway-Model-Armor-Response-Template">{model_armor_response_template}</Header>
      <Header name="X-Gateway-Model-Armor-Source">{model_armor_source}</Header>
      <Header name="X-Gateway-Auth-Source">{upstream_auth_source}</Header>
      <Header name="X-Gateway-Provider-Account">{openai_org_id}</Header>
      <Header name="X-Gateway-Identity-Persona">{identity_persona}</Header>
    </Headers>
  </Set>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <AssignTo createNew="false" transport="http" type="response"/>
</AssignMessage>
