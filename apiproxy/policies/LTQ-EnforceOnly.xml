<?xml version="1.0" encoding="UTF-8"?>
<LLMTokenQuota continueOnError="false" enabled="true" name="LTQ-EnforceOnly" type="rollingwindow">
  <DisplayName>LTQ-EnforceOnly</DisplayName>
  <SharedName>llm-token-counter</SharedName>
  <EnforceOnly>true</EnforceOnly>
  <Identifier ref="rate_limit_client_id"/>
  <Allow count="1000000" countRef="primary_quota_limit"/>
  <Interval ref="primary_quota_interval">1</Interval>
  <TimeUnit ref="primary_quota_unit">hour</TimeUnit>
  <Distributed>true</Distributed>
  <Synchronous>true</Synchronous>
  <LLMModelSource>{model}</LLMModelSource>
</LLMTokenQuota>
