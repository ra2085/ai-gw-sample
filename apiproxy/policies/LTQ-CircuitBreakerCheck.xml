<?xml version="1.0" encoding="UTF-8"?>
<LLMTokenQuota continueOnError="true" enabled="true" name="LTQ-CircuitBreakerCheck" type="rollingwindow">
  <DisplayName>LTQ-CircuitBreakerCheck</DisplayName>
  <SharedName>llm-circuit-breaker</SharedName>
  <EnforceOnly>true</EnforceOnly>
  <Identifier ref="primary_model"/>
  <Allow count="3" countRef="propertyset.config.cb_error_threshold"/>
  <Interval ref="propertyset.config.cb_window_interval">1</Interval>
  <TimeUnit ref="propertyset.config.cb_window_unit">minute</TimeUnit>
  <Distributed>true</Distributed>
  <Synchronous>true</Synchronous>
  <LLMModelSource>{primary_model}</LLMModelSource>
</LLMTokenQuota>
