<?xml version="1.0" encoding="UTF-8"?>
<LLMTokenQuota continueOnError="true" enabled="true" name="LTQ-CircuitBreakerCount" type="rollingwindow">
  <DisplayName>LTQ-CircuitBreakerCount</DisplayName>
  <SharedName>llm-circuit-breaker</SharedName>
  <CountOnly>true</CountOnly>
  <Identifier ref="tried_primary_model"/>
  <Allow count="3" countRef="propertyset.config.cb_error_threshold"/>
  <Interval ref="propertyset.config.cb_window_interval">1</Interval>
  <TimeUnit ref="propertyset.config.cb_window_unit">minute</TimeUnit>
  <Distributed>true</Distributed>
  <Synchronous>true</Synchronous>
  <LLMTokenUsageSource>{cb_error_weight}</LLMTokenUsageSource>
  <LLMModelSource>{circuit_breaker_checked}</LLMModelSource>
</LLMTokenQuota>
