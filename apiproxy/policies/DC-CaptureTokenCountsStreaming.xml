<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<DataCapture name="DC-CaptureTokenCountsStreaming" continueOnError="false" enabled="true">
  <DisplayName>DC-CaptureTokenCountsStreaming</DisplayName>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <ThrowExceptionOnLimit>false</ThrowExceptionOnLimit>
  <Capture>
    <Collect ref="usage_prompt_tokens" default="0"/>
    <DataCollector>dc_prompt_token_count</DataCollector>
  </Capture>
  <Capture>
    <Collect ref="usage_completion_tokens" default="0"/>
    <DataCollector>dc_completion_token_count</DataCollector>
  </Capture>
  <Capture>
    <Collect ref="usage_total_tokens" default="0"/>
    <DataCollector>dc_total_token_count</DataCollector>
  </Capture>
  <Capture>
    <Collect ref="model" default="unknown"/>
    <DataCollector>dc_model</DataCollector>
  </Capture>
  <Capture>
    <Collect ref="requested_model" default="direct"/>
    <DataCollector>dc_requested_model</DataCollector>
  </Capture>
</DataCapture>
