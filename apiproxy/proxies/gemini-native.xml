<?xml version="1.0" encoding="UTF-8"?>
<ProxyEndpoint name="gemini-native">
  <Description>Native Gemini API Proxy Endpoint compatible with ADK</Description>
  <FaultRules>
    <FaultRule name="sanitize">
      <Condition>(SanitizeUserPrompt.SUP-SanitizeUserPrompt.filterMatchState = "MATCH_FOUND") OR (SanitizeModelResponse.SMR-SanitizeModelResponse.filterMatchState = "MATCH_FOUND") OR (SanitizeModelResponse.SMR-SanitizeModelResponse.sdpFilterResult.deidentifyResult.matchState = "MATCH_FOUND") OR (SanitizeUserPrompt.SUP-SanitizeUserPrompt.sdpFilterResult.deidentifyResult.matchState = "MATCH_FOUND") OR (SanitizeUserPrompt.SUP-SanitizeUserPromptGemini.filterMatchState = "MATCH_FOUND") OR (SanitizeUserPrompt.SUP-SanitizeUserPromptGemini.sdpFilterResult.deidentifyResult.matchState = "MATCH_FOUND")</Condition>
      <Step>
        <Name>JS-inject-deidentified-finding</Name>
      </Step>
      <Step>
        <Name>AM-CustomError</Name>
      </Step>
    </FaultRule>
    <FaultRule name="rate-limit">
      <Condition>(fault.name = "QuotaViolation") OR (fault.name = "SpikeArrestViolation") OR (ratelimit.SA-BurstRateLimit.failed = true) OR (ratelimit.Q-ConcurrencyLimit.failed = true) OR (ratelimit.LTQ-EnforceOnly.failed = true) OR (ratelimit.LTQ-SecondaryEnforceOnly.failed = true)</Condition>
      <Step>
        <Name>JS-format-rate-limit-error</Name>
      </Step>
      <Step>
        <Name>AM-RateLimitError</Name>
      </Step>
    </FaultRule>
  </FaultRules>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>JS-extract-auth-credentials</Name>
      </Step>
      <Step>
        <Name>VA-ApiKey</Name>
        <Condition>(auth_has_apikey = "true") or (auth_try_bearer_as_apikey = "true")</Condition>
      </Step>
      <Step>
        <Name>OA-VerifyAccessToken</Name>
        <Condition>(auth_bearer_token != null) and (verifyapikey.VA-ApiKey.failed != "false")</Condition>
      </Step>
      <Step>
        <Name>SC-VerifyAgentToken</Name>
        <Condition>(auth_bearer_token != null) and (verifyapikey.VA-ApiKey.failed != "false") and (oauthV2.OA-VerifyAccessToken.failed = "true") and (auth_token_type = "agent_identity") and (propertyset.config.auth_agent_token_enabled = "true")</Condition>
      </Step>
      <Step>
        <Name>SC-VerifyIdpOpaqueToken</Name>
        <Condition>(auth_bearer_token != null) and (verifyapikey.VA-ApiKey.failed != "false") and (oauthV2.OA-VerifyAccessToken.failed = "true") and (auth_token_type = "idp_opaque") and (propertyset.config.auth_idp_opaque_enabled = "true")</Condition>
      </Step>
      <Step>
        <Name>VJ-VerifyIdpJwt</Name>
        <Condition>(auth_bearer_token != null) and (verifyapikey.VA-ApiKey.failed != "false") and (oauthV2.OA-VerifyAccessToken.failed = "true") and (auth_token_type = "idp_jwt") and (propertyset.config.auth_idp_jwt_enabled = "true")</Condition>
      </Step>
      <Step>
        <Name>JS-resolve-auth-persona</Name>
        <Condition>(auth_bearer_token != null) and (verifyapikey.VA-ApiKey.failed != "false") and (oauthV2.OA-VerifyAccessToken.failed = "true") and ((agentTokenVerifyResponse.status.code = 200) or (idpOpaqueVerifyResponse.status.code = 200) or (jwt.VJ-VerifyIdpJwt.valid = "true") or (jwt.VJ-VerifyIdpJwt.failed = "false"))</Condition>
      </Step>
      <Step>
        <Name>OA-ImportExternalToken</Name>
        <Condition>auth_ready_to_import = "true"</Condition>
      </Step>
      <Step>
        <Name>OA-SaveTokenAttributes</Name>
        <Condition>(auth_ready_to_import = "true") and (oauthV2.OA-ImportExternalToken.failed = "false")</Condition>
      </Step>
      <Step>
        <Name>JS-restore-request-payload</Name>
        <Condition>auth_ready_to_import = "true"</Condition>
      </Step>
      <Step>
        <Name>OA-VerifyAccessToken</Name>
        <Condition>(auth_ready_to_import = "true") and (oauthV2.OA-ImportExternalToken.failed = "false")</Condition>
      </Step>
      <Step>
        <Name>VA-ApiKey</Name>
        <Condition>(verifyapikey.VA-ApiKey.failed != "false") and ((oauthV2.OA-VerifyAccessToken.failed = "false") or (auth_ready_to_import = "true"))</Condition>
      </Step>
      <Step>
        <Name>RF-Unauthorized</Name>
        <Condition>(verifyapikey.VA-ApiKey.failed != "false") and (oauthV2.OA-VerifyAccessToken.failed != "false")</Condition>
      </Step>
      <Step>
        <Name>MLC-EnforceMonetizationLimits</Name>
      </Step>
      <Step>
        <Name>OAS-VerifyGemini</Name>
      </Step>
      <Step>
        <Name>JS-extract-vars-gemini</Name>
      </Step>
      <Step>
        <Name>JS-prepare-judge-request</Name>
        <Condition>(request.header.X-Gateway-Judge = "true") or (request.header.x-enable-judge = "true") or (model = "auto:judge") or (model = "gateway/judge") or (has_judge_payload = "true")</Condition>
      </Step>
      <Step>
        <Name>SC-LLMJudge</Name>
        <Condition>trigger_judge = "true"</Condition>
      </Step>
      <Step>
        <Name>JS-process-judge-response</Name>
        <Condition>trigger_judge = "true"</Condition>
      </Step>
      <Step>
        <Name>JS-resolve-model-location</Name>
      </Step>
      <Step>
        <Name>RF-Unauthorized</Name>
        <Condition>model_access_denied = "true"</Condition>
      </Step>
      <Step>
        <Name>LTQ-CircuitBreakerCheck</Name>
        <Condition>(fallback_model != null) and (fallback_model != "") and (allow_fallbacks = "true")</Condition>
      </Step>
      <Step>
        <Name>JS-resolve-model-location</Name>
        <Condition>(fallback_model != null) and (fallback_model != "") and (allow_fallbacks = "true") and ((ratelimit.LTQ-CircuitBreakerCheck.failed = true) or (ratelimit.LTQ-CircuitBreakerCheck.exceed.count &gt; 0) or (ratelimit.LTQ-CircuitBreakerCheck.available.count = 0))</Condition>
      </Step>
      <Step>
        <Name>LTQ-EnforceOnly</Name>
        <Condition>apiproduct.name != null</Condition>
      </Step>
      <Step>
        <Name>SUP-SanitizeUserPromptGemini</Name>
        <Condition>(model_armor_request_enabled != "false") and (request_format = "gemini") and (gemini_text_prompt != null) and (gemini_text_prompt != "")</Condition>
      </Step>
      <Step>
        <Name>SUP-SanitizeUserPrompt</Name>
        <Condition>(model_armor_request_enabled != "false") and (request_format = "claude") and (extracted_prompt != null) and (extracted_prompt != "")</Condition>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows/>
  <PostFlow name="PostFlow">
    <Request/>
    <Response>
      <Step>
        <Name>LTQ-CircuitBreakerCount</Name>
        <Condition>((response.status.code = 429) or (response.status.code &gt;= 500)) and (fallback_model != null) and (fallback_model != "") and (allow_fallbacks = "true")</Condition>
      </Step>
      <Step>
        <Name>JS-prepare-fallback-request</Name>
        <Condition>((response.status.code = 429) or (response.status.code &gt;= 500)) and (fallback_model != null) and (fallback_model != "") and (allow_fallbacks = "true")</Condition>
      </Step>
      <Step>
        <Name>SC-FallbackGoogleIAM</Name>
        <Condition>(fallback_ready = "true") and (fallback_use_google_iam = "true")</Condition>
      </Step>
      <Step>
        <Name>SC-FallbackExternal</Name>
        <Condition>(fallback_ready = "true") and (fallback_use_google_iam != "true")</Condition>
      </Step>
      <Step>
        <Name>JS-apply-fallback-response</Name>
        <Condition>fallback_ready = "true"</Condition>
      </Step>
      <Step>
        <Name>EV-ExtractMetadataNonStreamingGemini</Name>
        <Condition>!(stream = true) and (response.status.code &lt; 400) and request_format = "gemini"</Condition>
      </Step>
      <Step>
        <Name>EV-ExtractMetadataNonStreaming</Name>
        <Condition>!(stream = true) and (response.status.code &lt; 400) and request_format = "claude"</Condition>
      </Step>
      <Step>
        <Name>JS-calculate-tokens-non-streaming</Name>
        <Condition>!(stream = true) and (response.status.code &lt; 400)</Condition>
      </Step>
      <Step>
        <Name>SMR-SanitizeModelResponse</Name>
        <Condition>!(stream = true) and (response.status.code &lt; 400) and (model_armor_response_enabled != "false") and (response_partial != null) and (response_partial != "")</Condition>
      </Step>
      <Step>
        <Name>JS-calculate-monetization-cost</Name>
        <Condition>!(stream = true) and (response.status.code &lt; 400)</Condition>
      </Step>
      <Step>
        <Name>DC-CaptureTokenCountsNonStreaming</Name>
        <Condition>!(stream = true) and (response.status.code &lt; 400)</Condition>
      </Step>
      <Step>
        <Name>LTQ-CountOnly</Name>
        <Condition>(!(stream = true)) AND (response.status.code &lt; 400) AND (usage_total_tokens != null) AND (apiproduct.name != null)</Condition>
      </Step>
      <Step>
        <Name>AM-SetQuotaHeaders</Name>
        <Condition>!(stream = true) and (response.status.code &lt; 400)</Condition>
      </Step>
      <Step>
        <Name>AM-SetMonetizationHeaders</Name>
        <Condition>!(stream = true) and (response.status.code &lt; 400)</Condition>
      </Step>
    </Response>
  </PostFlow>
  <HTTPProxyConnection>
    <BasePath>/ai-gateway</BasePath>
    <Properties>
      <Property name="response.streaming.enabled">true</Property>
      <Property name="api.timeout">300000</Property>
    </Properties>
  </HTTPProxyConnection>
  <RouteRule name="claude">
    <Condition>route_target = "claude" or proxy.pathsuffix MatchesPath "/v1/projects/*/locations/*/publishers/anthropic/models/*"</Condition>
    <TargetEndpoint>claude</TargetEndpoint>
  </RouteRule>
  <RouteRule name="gemini-native-target">
    <TargetEndpoint>gemini-native-target</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
