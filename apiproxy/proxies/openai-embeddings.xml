<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="openai-embeddings">
  <Description>OpenAI Embeddings API Proxy Endpoint for Vertex AI and BYO Models</Description>
  <FaultRules>
    <FaultRule name="rate-limit">
      <Step>
        <Name>JS-format-rate-limit-error</Name>
      </Step>
      <Step>
        <Name>AM-RateLimitError</Name>
      </Step>
      <Condition>(fault.name = "QuotaViolation") OR (fault.name = "SpikeArrestViolation") OR (ratelimit.LTQ-EnforceOnly.failed = true)</Condition>
    </FaultRule>
    <FaultRule name="sanitize">
      <Step>
        <Name>JS-inject-deidentified-finding</Name>
      </Step>
      <Step>
        <Name>AM-CustomError</Name>
      </Step>
      <Condition>(SanitizeUserPrompt.SUP-SanitizeUserPrompt.filterMatchState  = "MATCH_FOUND") OR (SanitizeModelResponse.SMR-SanitizeModelResponse.sdpFilterResult.deidentifyResult.matchState = "MATCH_FOUND") OR (SanitizeUserPrompt.SUP-SanitizeUserPrompt.sdpFilterResult.deidentifyResult.matchState = "MATCH_FOUND")</Condition>
    </FaultRule>
  </FaultRules>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>JS-extract-auth-credentials</Name>
      </Step>
      <Step>
        <Condition>(auth_has_apikey = "true") or (auth_try_bearer_as_apikey = "true")</Condition>
        <Name>VA-ApiKey</Name>
      </Step>
      <Step>
        <Condition>(auth_bearer_token != null) and (verifyapikey.VA-ApiKey.failed != "false")</Condition>
        <Name>OA-VerifyAccessToken</Name>
      </Step>
      <Step>
        <Condition>(auth_bearer_token != null) and (verifyapikey.VA-ApiKey.failed != "false") and (oauthV2.OA-VerifyAccessToken.failed = "true") and (auth_token_type = "agent_identity") and (propertyset.config.auth_agent_token_enabled = "true")</Condition>
        <Name>SC-VerifyAgentToken</Name>
      </Step>
      <Step>
        <Condition>(auth_bearer_token != null) and (verifyapikey.VA-ApiKey.failed != "false") and (oauthV2.OA-VerifyAccessToken.failed = "true") and (auth_token_type = "idp_opaque") and (propertyset.config.auth_idp_opaque_enabled = "true")</Condition>
        <Name>SC-VerifyIdpOpaqueToken</Name>
      </Step>
      <Step>
        <Condition>(auth_bearer_token != null) and (verifyapikey.VA-ApiKey.failed != "false") and (oauthV2.OA-VerifyAccessToken.failed = "true") and (auth_token_type = "idp_jwt") and (propertyset.config.auth_idp_jwt_enabled = "true")</Condition>
        <Name>VJ-VerifyIdpJwt</Name>
      </Step>
      <Step>
        <Condition>(auth_bearer_token != null) and (verifyapikey.VA-ApiKey.failed != "false") and (oauthV2.OA-VerifyAccessToken.failed = "true")</Condition>
        <Name>JS-resolve-auth-persona</Name>
      </Step>
      <Step>
        <Condition>auth_ready_to_import = "true"</Condition>
        <Name>OA-ImportExternalToken</Name>
      </Step>
      <Step>
        <Condition>(auth_ready_to_import = "true") and (oauthV2.OA-ImportExternalToken.failed = "false")</Condition>
        <Name>OA-SaveTokenAttributes</Name>
      </Step>
      <Step>
        <Condition>auth_ready_to_import = "true"</Condition>
        <Name>JS-restore-request-payload</Name>
      </Step>
      <Step>
        <Condition>(auth_ready_to_import = "true") and (oauthV2.OA-ImportExternalToken.failed = "false")</Condition>
        <Name>OA-VerifyAccessToken</Name>
      </Step>
      <Step>
        <Condition>(verifyapikey.VA-ApiKey.failed != "false") and (oauthV2.OA-VerifyAccessToken.failed != "false")</Condition>
        <Name>RF-Unauthorized</Name>
      </Step>
      <Step>
        <Name>MLC-EnforceMonetizationLimits</Name>
      </Step>
      <Step>
        <Name>AM-NormalizePathSuffix</Name>
      </Step>
      <Step>
        <Name>OAS-VerifyOpenAI</Name>
      </Step>
      <Step>
        <Name>JS-extract-vars-openai</Name>
      </Step>
      <Step>
        <Name>JS-resolve-model-location</Name>
      </Step>
      <Step>
        <Condition>apiproduct.name != null</Condition>
        <Name>LTQ-EnforceOnly</Name>
      </Step>
      <Step>
        <Condition>extracted_prompt != null and extracted_prompt != ""</Condition>
        <Name>SUP-SanitizeUserPrompt</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response>
      <Step>
        <Condition>!(stream = true)</Condition>
        <Name>EV-ExtractMetadataNonStreamingOpenAI</Name>
      </Step>
      <Step>
        <Condition>!(stream = true)</Condition>
        <Name>JS-calculate-tokens-non-streaming</Name>
      </Step>
      <Step>
        <Condition>!(stream = true)</Condition>
        <Name>JS-calculate-monetization-cost</Name>
      </Step>
      <Step>
        <Condition>!(stream = true)</Condition>
        <Name>DC-CaptureTokenCountsNonStreaming</Name>
      </Step>
      <Step>
        <Condition>(!(stream = true)) AND (usage_total_tokens != null) AND (apiproduct.name != null)</Condition>
        <Name>LTQ-CountOnly</Name>
      </Step>
      <Step>
        <Condition>!(stream = true)</Condition>
        <Name>AM-SetQuotaHeaders</Name>
      </Step>
      <Step>
        <Condition>!(stream = true)</Condition>
        <Name>AM-SetMonetizationHeaders</Name>
      </Step>
    </Response>
  </PostFlow>
  <Flows/>
  <HTTPProxyConnection>
    <BasePath>/v1/embeddings</BasePath>
    <Properties>
      <Property name="response.streaming.enabled">false</Property>
      <Property name="api.timeout">300000</Property>
    </Properties>
  </HTTPProxyConnection>
  <RouteRule name="openai-custom">
    <Condition>route_target = "openai-custom"</Condition>
    <TargetEndpoint>openai-custom</TargetEndpoint>
  </RouteRule>
  <RouteRule name="gemini-openai-compat">
    <TargetEndpoint>gemini-openai-compat</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
